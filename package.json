{
  "name": "glasstube",
  "version": "0.8.2",
  "private": true,
  "description": "A Chrome extension that reimagines YouTube with a cinematic, Apple TV-inspired Liquid Glass interface.",
  "license": "MIT",
  "author": "Aashish Paruvada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theysap/GlassTube.git"
  },
  "homepage": "https://github.com/theysap/GlassTube#readme",
  "bugs": {
    "url": "https://github.com/theysap/GlassTube/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/",
    "validate": "node scripts/validate.mjs",
    "check": "npm run lint && npm test && npm run validate",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release:local": "npm run check && npm run build -- --store && npm run screenshots",
    "release:notes": "node scripts/release-notes.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "bump": "node scripts/bump.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.css": [
      "stylelint",
      "prettier --check"
    ],
    "*.{json,md,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
