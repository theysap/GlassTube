{
  "manifest_version": 3,
  "name": "GlassTube",
  "short_name": "GlassTube",
  "version": "0.1.0",
  "description": "Reimagine YouTube as a cinematic, Apple TV-inspired experience with a Liquid Glass design.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/theysap/GlassTube",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GlassTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/embed/*", "https://www.youtube.com/live_chat*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/embed/*", "https://www.youtube.com/live_chat*"],
      "css": ["styles/theme.css"],
      "js": ["content/core.js", "content/registry.js", "content/main.js"],
      "run_at": "document_start"
    }
  ]
}
